#!/bin/bash

########################################################################
# Ubuntu 24.04 LTS DISA STIG
# PART 3 - SSH HARDENING
#
# Based on findings/remediation requirements in the uploaded
# Ubuntu 24.04 LTS OpenSCAP report.
#
# IMPORTANT:
# - Creates backups before modification.
# - Validates sshd configuration before reload.
# - Does NOT automatically configure PIV/CAC authentication.
########################################################################

set -u

########################################################################
# COLORS
########################################################################

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

########################################################################
# VARIABLES
########################################################################

SSH_SERVER="/etc/ssh/sshd_config"
SSH_CLIENT="/etc/ssh/ssh_config"

STIG_DIR="/etc/ssh/sshd_config.d"
STIG_FILE="$STIG_DIR/99-disa-stig.conf"

BACKUP_DIR="/root/ubuntu-stig-backups/part3"

PASS_COUNT=0
FAIL_COUNT=0
WARN_COUNT=0

########################################################################
# FUNCTIONS
########################################################################

pass() {
    echo -e "${GREEN}[PASS]${NC} $1"
    PASS_COUNT=$((PASS_COUNT + 1))
}

fail() {
    echo -e "${RED}[FAIL]${NC} $1"
    FAIL_COUNT=$((FAIL_COUNT + 1))
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
    WARN_COUNT=$((WARN_COUNT + 1))
}

info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

########################################################################
# ROOT CHECK
########################################################################

if [ "$EUID" -ne 0 ]; then

    echo "ERROR: This script must be run as root."

    echo
    echo "Run:"
    echo "sudo -i"
    echo "/root/part3_ssh.sh"

    exit 1

fi

########################################################################
# HEADER
########################################################################

echo
echo "============================================================"
echo " Ubuntu 24.04 DISA STIG - PART 3"
echo " SSH HARDENING"
echo "============================================================"
echo

########################################################################
# CHECK SSH
########################################################################

info "Checking SSH installation..."

if command -v sshd >/dev/null 2>&1; then

    pass "SSH daemon is installed"

else

    fail "SSH daemon is not installed"

    echo
    echo "The report indicates SSH should be installed."
    echo "Install it with:"
    echo
    echo "apt-get install openssh-server"
    echo

    exit 1

fi

########################################################################
# CREATE BACKUP DIRECTORY
########################################################################

mkdir -p "$BACKUP_DIR"

########################################################################
# BACKUP SSH CONFIGURATION
########################################################################

info "Backing up SSH configuration..."

if [ -f "$SSH_SERVER" ]; then

    cp -a "$SSH_SERVER" \
        "$BACKUP_DIR/sshd_config.$(date +%Y%m%d_%H%M%S).backup"

    pass "Backed up sshd_config"

else

    fail "sshd_config does not exist"

fi

if [ -f "$SSH_CLIENT" ]; then

    cp -a "$SSH_CLIENT" \
        "$BACKUP_DIR/ssh_config.$(date +%Y%m%d_%H%M%S).backup"

    pass "Backed up ssh_config"

else

    fail "ssh_config does not exist"

fi

########################################################################
# CREATE STIG CONFIGURATION DIRECTORY
########################################################################

mkdir -p "$STIG_DIR"

chmod 0755 "$STIG_DIR"

########################################################################
# BACKUP EXISTING STIG FILE
########################################################################

if [ -f "$STIG_FILE" ]; then

    cp -a "$STIG_FILE" \
        "$BACKUP_DIR/99-disa-stig.conf.$(date +%Y%m%d_%H%M%S).backup"

fi

########################################################################
# WRITE SSH SERVER CONFIGURATION
#
# These values are taken from the remediation requirements appearing
# in the uploaded report.
########################################################################

info "Creating DISA STIG SSH server configuration..."

cat > "$STIG_FILE" <<'EOF'
#
# Ubuntu 24.04 DISA STIG
# Part 3 - SSH Hardening
#

# Multifactor/public-key authentication requirement
PubkeyAuthentication yes

# PAM authentication
UsePAM yes

# Disable X11 forwarding
X11Forwarding no

# FIPS-approved SSH server ciphers
Ciphers aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes128-ctr

# FIPS-approved SSH server MACs
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256

# FIPS-approved key exchange algorithms
KexAlgorithms ecdh-sha2-nistp521,ecdh-sha2-nistp384,ecdh-sha2-nistp256,diffie-hellman-group-exchange-sha256,diffie-hellman-group16-sha512,diffie-hellman-group14-sha256

# Do not permit root password login
PermitRootLogin prohibit-password

# Do not permit password authentication as a replacement
# for public-key authentication when key-based authentication
# is being used.
#
# PasswordAuthentication is intentionally not forced off here
# because the uploaded report does not provide sufficient evidence
# that password authentication should be globally disabled.
EOF

chmod 0644 "$STIG_FILE"

pass "Created $STIG_FILE"

########################################################################
# SSH CONFIGURATION TEST
########################################################################

echo
echo "------------------------------------------------------------"
echo "Testing SSH configuration"
echo "------------------------------------------------------------"

if sshd -t; then

    pass "sshd configuration syntax is valid"

else

    fail "sshd configuration syntax is INVALID"

    echo
    echo "The SSH service was NOT reloaded."
    echo
    echo "Run:"
    echo "sshd -t"
    echo
    echo "to see the configuration error."

    exit 1

fi

########################################################################
# ENABLE SSH SERVICE
#
# The report shows ssh.service active but disabled.
########################################################################

echo
echo "------------------------------------------------------------"
echo "SSH Service"
echo "------------------------------------------------------------"

if systemctl enable ssh.service >/dev/null 2>&1; then

    pass "SSH service enabled at boot"

else

    fail "Unable to enable SSH service"

fi

########################################################################
# ENSURE SSH IS RUNNING
########################################################################

if systemctl is-active --quiet ssh.service; then

    pass "SSH service is currently active"

else

    info "SSH service is not active; attempting to start it..."

    if systemctl start ssh.service; then

        pass "SSH service started"

    else

        fail "Unable to start SSH service"

    fi

fi

########################################################################
# RELOAD SSH
#
# Use reload instead of restart to minimize disruption to existing
# connections.
########################################################################

echo
echo "------------------------------------------------------------"
echo "Reloading SSH"
echo "------------------------------------------------------------"

if systemctl reload ssh.service; then

    pass "SSH configuration reloaded successfully"

else

    fail "SSH configuration reload failed"

    echo
    echo "Existing SSH configuration has NOT been intentionally replaced."
    echo

fi

########################################################################
# VERIFY EFFECTIVE SSH SERVER SETTINGS
########################################################################

echo
echo "============================================================"
echo " EFFECTIVE SSH SERVER CONFIGURATION"
echo "============================================================"

echo

echo "PubkeyAuthentication:"
sshd -T 2>/dev/null | grep '^pubkeyauthentication ' || true

echo
echo "UsePAM:"
sshd -T 2>/dev/null | grep '^usepam ' || true

echo
echo "X11Forwarding:"
sshd -T 2>/dev/null | grep '^x11forwarding ' || true

echo
echo "Ciphers:"
sshd -T 2>/dev/null | grep '^ciphers ' || true

echo
echo "MACs:"
sshd -T 2>/dev/null | grep '^macs ' || true

echo
echo "KexAlgorithms:"
sshd -T 2>/dev/null | grep '^kexalgorithms ' || true

########################################################################
# VERIFY PUBKEYAUTHENTICATION
########################################################################

echo
echo "------------------------------------------------------------"
echo "SV-270672 / SSH Public Key Authentication"
echo "------------------------------------------------------------"

if sshd -T 2>/dev/null |
   grep -qi '^pubkeyauthentication yes$'; then

    pass "PubkeyAuthentication is enabled"

else

    fail "PubkeyAuthentication is not enabled"

fi

########################################################################
# VERIFY USEPAM
########################################################################

echo
echo "------------------------------------------------------------"
echo "SSH UsePAM"
echo "------------------------------------------------------------"

if sshd -T 2>/dev/null |
   grep -qi '^usepam yes$'; then

    pass "UsePAM is enabled"

else

    fail "UsePAM is not enabled"

fi

########################################################################
# VERIFY X11 FORWARDING
########################################################################

echo
echo "------------------------------------------------------------"
echo "SSH X11 Forwarding"
echo "------------------------------------------------------------"

if sshd -T 2>/dev/null |
   grep -qi '^x11forwarding no$'; then

    pass "X11Forwarding is disabled"

else

    fail "X11Forwarding is NOT disabled"

fi

########################################################################
# VERIFY SERVER CIPHERS
########################################################################

echo
echo "------------------------------------------------------------"
echo "SSH Server Ciphers"
echo "------------------------------------------------------------"

EXPECTED_CIPHERS="aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes128-ctr"

ACTUAL_CIPHERS=$(sshd -T 2>/dev/null |
    awk '$1=="ciphers" {$1=""; sub(/^ /,""); print}')

if [ "$ACTUAL_CIPHERS" = "$EXPECTED_CIPHERS" ]; then

    pass "SSH server ciphers match STIG requirement"

else

    fail "SSH server ciphers do not match required value"

    echo "Expected:"
    echo "$EXPECTED_CIPHERS"

    echo "Actual:"
    echo "$ACTUAL_CIPHERS"

fi

########################################################################
# VERIFY SERVER MACS
########################################################################

echo
echo "------------------------------------------------------------"
echo "SSH Server MACs"
echo "------------------------------------------------------------"

EXPECTED_MACS="hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256"

ACTUAL_MACS=$(sshd -T 2>/dev/null |
    awk '$1=="macs" {$1=""; sub(/^ /,""); print}')

if [ "$ACTUAL_MACS" = "$EXPECTED_MACS" ]; then

    pass "SSH server MACs match STIG requirement"

else

    fail "SSH server MACs do not match required value"

    echo "Expected:"
    echo "$EXPECTED_MACS"

    echo "Actual:"
    echo "$ACTUAL_MACS"

fi

########################################################################
# VERIFY KEY EXCHANGE
########################################################################

echo
echo "------------------------------------------------------------"
echo "SSH Server Key Exchange Algorithms"
echo "------------------------------------------------------------"

EXPECTED_KEX="ecdh-sha2-nistp521,ecdh-sha2-nistp384,ecdh-sha2-nistp256,diffie-hellman-group-exchange-sha256,diffie-hellman-group16-sha512,diffie-hellman-group14-sha256"

ACTUAL_KEX=$(sshd -T 2>/dev/null |
    awk '$1=="kexalgorithms" {$1=""; sub(/^ /,""); print}')

if [ "$ACTUAL_KEX" = "$EXPECTED_KEX" ]; then

    pass "SSH server KexAlgorithms match STIG requirement"

else

    fail "SSH server KexAlgorithms do not match required value"

    echo "Expected:"
    echo "$EXPECTED_KEX"

    echo "Actual:"
    echo "$ACTUAL_KEX"

fi

########################################################################
# SSH CLIENT CIPHERS
#
# Report explicitly requires this in /etc/ssh/ssh_config.
########################################################################

echo
echo "============================================================"
echo " SSH CLIENT CONFIGURATION"
echo "============================================================"

info "Configuring SSH client ciphers..."

CLIENT_CIPHERS="Ciphers aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes128-ctr"

if grep -Eq '^[[:space:]]*Ciphers[[:space:]]+' "$SSH_CLIENT"; then

    sed -i -E \
    's|^[[:space:]]*Ciphers[[:space:]]+.*|'"$CLIENT_CIPHERS"'|' \
    "$SSH_CLIENT"

else

    printf '\n%s\n' "$CLIENT_CIPHERS" >> "$SSH_CLIENT"

fi

if grep -Eq \
'^[[:space:]]*Ciphers[[:space:]]+aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes128-ctr[[:space:]]*$' \
"$SSH_CLIENT"; then

    pass "SSH client ciphers configured"

else

    fail "SSH client ciphers are not configured correctly"

fi

########################################################################
# SSH CLIENT MACS
########################################################################

info "Configuring SSH client MACs..."

CLIENT_MACS="MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256"

if grep -Eq '^[[:space:]]*MACs[[:space:]]+' "$SSH_CLIENT"; then

    sed -i -E \
    's|^[[:space:]]*MACs[[:space:]]+.*|'"$CLIENT_MACS"'|' \
    "$SSH_CLIENT"

else

    printf '\n%s\n' "$CLIENT_MACS" >> "$SSH_CLIENT"

fi

if grep -Eq \
'^[[:space:]]*MACs[[:space:]]+hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256[[:space:]]*$' \
"$SSH_CLIENT"; then

    pass "SSH client MACs configured"

else

    fail "SSH client MACs are not configured correctly"

fi

########################################################################
# VERIFY SSH CLIENT CONFIGURATION
########################################################################

echo
echo "------------------------------------------------------------"
echo "SSH Client Configuration"
echo "------------------------------------------------------------"

grep -E \
'^[[:space:]]*(Ciphers|MACs)[[:space:]]+' \
"$SSH_CLIENT" || true

########################################################################
# PIV / CAC NOTICE
########################################################################

echo
echo "============================================================"
echo " PIV / CAC REQUIREMENT"
echo "============================================================"

warn "PIV/CAC authentication was NOT automatically configured."

echo
echo "The uploaded report identifies PIV credentials as a failed"
echo "requirement. That requires PKI/certificate infrastructure and"
echo "cannot safely be fixed by simply changing sshd_config."

########################################################################
# FINAL SSH STATUS
########################################################################

echo
echo "============================================================"
echo " SSH SERVICE STATUS"
echo "============================================================"

systemctl --no-pager --full status ssh.service | \
    sed -n '1,12p'

########################################################################
# SUMMARY
########################################################################

echo
echo "============================================================"
echo " PART 3 SUMMARY"
echo "============================================================"

echo -e "${GREEN}PASS: $PASS_COUNT${NC}"
echo -e "${RED}FAIL: $FAIL_COUNT${NC}"
echo -e "${YELLOW}WARN: $WARN_COUNT${NC}"

echo
echo "Backups:"
echo "$BACKUP_DIR"

echo
echo "SSH STIG configuration:"
echo "$STIG_FILE"

echo
echo "============================================================"

if [ "$FAIL_COUNT" -eq 0 ]; then

    echo -e "${GREEN}PART 3 COMPLETED WITHOUT FAILURES${NC}"

else

    echo -e "${RED}PART 3 COMPLETED WITH $FAIL_COUNT FAILURE(S)${NC}"

fi

echo "============================================================"
echo
